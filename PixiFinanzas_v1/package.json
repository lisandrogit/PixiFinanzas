{
  "name": "pixifinanzas-v1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "seed:build": "node scripts/build-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply pixifinanzas --local",
